module beam(len, pos, rot, rgb){
  color(rgb)
    translate(pos)
      rotate(rot)
        cube([len, thickness, width], center=true);
}

// Red bounding box from (0,0,0) to (5800,4800,2400)
bbox = [5800, 4800, 2400];
edge = 10;
module bbox_wire(b){
  x=b[0]; y=b[1]; z=b[2];
  color([1,0,0]) {
    for (yy=[0,y], zz=[0,z]) translate([x/2, yy, zz]) cube([x, edge, edge], center=true);
    for (xx=[0,x], zz=[0,z]) translate([xx, y/2, zz]) cube([edge, y, edge], center=true);
    for (xx=[0,x], yy=[0,y]) translate([xx, yy, z/2]) cube([edge, edge, z], center=true);
  }
}

bbox_wire(bbox);

